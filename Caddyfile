# Caddy config for the Atomic CRM static SPA on Railway.
# Serves the built dist/ and reverse-proxies API + storage calls to the api
# service over Railway private networking, so the browser sees a single origin
# (no CORS, no build-time backend secrets).
{
	admin off
	auto_https off
}

:{$PORT:80} {
	encode zstd gzip

	# Forward API and file-storage traffic to the backend service.
	# API_ORIGIN example: api.railway.internal:3000
	@backend path /api/* /storage/*
	handle @backend {
		reverse_proxy {$API_ORIGIN}
	}

	# Everything else is the SPA; unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
