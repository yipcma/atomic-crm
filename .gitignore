# Shadcn Registry
public/r/

# Secret material — never tracked. (.env.development stays tracked on purpose:
# it holds only local-dev pointers and a publishable key, and dropping it would
# break `npm run dev` on a fresh clone.)
.env.e2e
supabase/functions/.env
supabase/signing_keys.json

.claude/settings.local.json

# Harness scratch (promotion lock; worktrees + test-results also cleaned at SessionEnd)
.promote.lock
# Rendered per-session harness board (render-status hook; cleaned at SessionEnd)
/.harness/

# Playwright
.playwright-mcp/
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

*.lock
 
# Bundle analysis output (npm run build:analyze)
.analyze/

# Vitest browser-mode failure screenshots
.vitest-attachments/
